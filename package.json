{
  "name": "virtual-herbal-garden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "validate:data": "esbuild scripts/validate-data.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/validate-data.mjs && node node_modules/.tmp/validate-data.mjs",
    "validate:models": "node scripts/validate-models.mjs",
    "inspect:model": "gltf-transform inspect",
    "optimize:model": "node scripts/optimize-model.mjs",
    "build:garden-assets": "node scripts/build-garden-assets.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@gltf-transform/cli": "4.5.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.4"
  },
  "packageManager": "pnpm@11.19.0"
}
